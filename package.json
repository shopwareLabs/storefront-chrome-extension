{
  "name": "shopware-storefront-chrome-extension",
  "version": "1.0.0",
  "private": true,
  "author": "Shopware AG",
  "license": "MIT",
  "description": "Chrome DevTools extension for debugging Shopware Storefront components",
  "keywords": [
    "shopware",
    "storefront",
    "chrome-extension",
    "devtools"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run format && vite build",
    "dev": "npm run format && vite build --watch",
    "format": "prettier --write \"src/**/*\"",
    "format:check": "prettier --check \"src/**/*\""
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.3",
    "prettier": "3.7.4",
    "rollup-plugin-copy": "3.5.0",
    "vite": "7.2.7",
    "vite-plugin-static-copy": "3.1.4"
  },
  "dependencies": {
    "@shopware-ag/meteor-component-library": "4.24.0",
    "vue": "3.5.25"
  }
}

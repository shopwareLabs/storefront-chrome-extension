{
    "name": "Shopware Storefront Developer Tools",
    "description": "Tools for developers to debug and test the Shopware Storefront",
    "version": "1.0",
    "manifest_version": 3,
    "devtools_page": "devtools.html",
    "permissions": ["storage", "activeTab", "scripting"],
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": ["panels/storefront/scripts/*.js"],
            "matches": ["<all_urls>"]
        }
    ],
    "action": {
        "default_icon": "icon.png"
    }
}
